# ---------------------------------------------------------------------------
# Daydrift environment. Copy to .env (pnpm setup does this automatically).
# Parsed + validated once in packages/config. See docs/08-config-env.md.
# Defaults below are wired for local dev (docker-compose + Ollama).
# ---------------------------------------------------------------------------

# --- Core infrastructure (required) ---
# Host ports docker-compose publishes. Override (and match the URLs below) if 5432/6379 are taken.
# POSTGRES_PORT=5432
# REDIS_PORT=6379
DATABASE_URL=postgresql://daydrift:daydrift@localhost:5432/daydrift
REDIS_URL=redis://localhost:6379

# --- Auth (required; AUTH_SECRET has NO default — app fails fast if unset) ---
AUTH_SECRET=change-me-generate-a-strong-random-value
BASE_URL=http://localhost:3000
WEB_URL=http://localhost:5173

# --- LLM provider: ollama (dev) | openai (prod) | generic OpenAI-compatible ---
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b
# LLM_BASE_URL=        # generic OpenAI-compatible endpoint
# LLM_API_KEY=         # generic OpenAI-compatible key
# LLM_TIMEOUT_MS=90000 # per-call cap; on timeout the worker falls back to a proximity itinerary

# --- Embedding provider. EMBEDDING_MODEL determines the vector dimension. ---
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_DIM=       # required ONLY for a model not in the built-in map
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=

# --- OpenAI (required in prod when provider=openai) ---
# OPENAI_API_KEY=

# --- Ollama (required in dev when provider=ollama) ---
OLLAMA_BASE_URL=http://localhost:11434

# --- OAuth (optional; providers enabled only if the ID is set) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# --- External services (optional; default to public endpoints) ---
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter
# OSRM_BASE_URL=https://routing.openstreetmap.de

# --- Runtime ---
NODE_ENV=development
PORT=3000

# --- Frontend (build-time; baked into the SPA) ---
VITE_API_URL=http://localhost:3000
