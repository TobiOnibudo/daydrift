{
  "name": "daydrift",
  "version": "0.1.0",
  "private": true,
  "description": "Daydrift — AI city-guide / trip-planning app (RAG over geospatial place data)",
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "setup": "node scripts/setup.mjs",
    "db:migrate": "pnpm --filter @daydrift/db migrate",
    "db:generate": "pnpm --filter @daydrift/db generate",
    "db:studio": "pnpm --filter @daydrift/db studio",
    "seed": "pnpm --filter @daydrift/core seed",
    "clean": "turbo run clean && rimraf node_modules",
    "prepare": "husky",
    "eval": "pnpm --filter @daydrift/core eval",
    "test:integration": "pnpm --filter @daydrift/core test:integration",
    "e2e": "pnpm build && pnpm --filter @daydrift/e2e e2e",
    "load": "pnpm build && pnpm --filter @daydrift/e2e load"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@playwright/test": "^1.63.0",
    "eslint": "^9.0.0",
    "eslint-plugin-import": "^2.29.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.3.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "rimraf": "^6.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9"
  }
}
