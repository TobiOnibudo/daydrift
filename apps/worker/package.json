{
  "name": "@daydrift/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./events": {
      "types": "./dist/events.d.ts",
      "import": "./dist/events.js"
    },
    "./logger": {
      "types": "./dist/logger.d.ts",
      "import": "./dist/logger.js"
    },
    "./processors/ai-plan": {
      "types": "./dist/processors/ai-plan.d.ts",
      "import": "./dist/processors/ai-plan.js"
    },
    "./processors/deps": {
      "types": "./dist/processors/deps.d.ts",
      "import": "./dist/processors/deps.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@daydrift/ai": "workspace:*",
    "@daydrift/config": "workspace:*",
    "@daydrift/core": "workspace:*",
    "@daydrift/db": "workspace:*",
    "@daydrift/queue": "workspace:*",
    "@daydrift/types": "workspace:*",
    "ioredis": "^6.0.0",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.7.0",
    "vitest": "^2.1.0"
  }
}
