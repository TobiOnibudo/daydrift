{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm turbo run build --filter=@daydrift/web... --filter=@daydrift/api...",
  "outputDirectory": "apps/web/dist",
  "installCommand": "pnpm install --frozen-lockfile --prod=false",
  "rewrites": [
    {
      "source": "/((?!api/|health$).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/[...path].ts": {
      "maxDuration": 60
    },
    "api/health.ts": {
      "maxDuration": 60
    },
    "api/ai-plan.ts": {
      "maxDuration": 300,
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "ai-plan",
          "retryAfterSeconds": 60,
          "initialDelaySeconds": 0
        }
      ]
    }
  }
}
